# 실제 값은 .env에 채워 넣을 것 (.env는 git-ignore됨, 절대 커밋하지 않는다)

# V-World — 연속지적도 WFS (PNU → 필지 폴리곤 복원, ARCHITECTURE.md §3.2)
VWORLD_API_KEY=

# Google Earth Engine — Sentinel-2 시계열 (ARCHITECTURE.md §3.4, Module OBS)
# 필수: 등록된 Google Cloud 프로젝트 ID (Earth Engine이 프로젝트 단위 인증을 요구함)
GEE_PROJECT_ID=
# 선택: 서비스 계정으로 헤드리스 인증할 때만 채운다. 비워두면 로컬에서
# `earthengine authenticate`로 이미 캐시된 사용자 자격증명을 사용한다.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# (선택, B급 확장) 기상청 API허브 — 강우·수문 이벤트 트리거용
KMA_API_KEY=
